{
  "name": "fastgpt-plugin-deepseek-search",
  "version": "0.1.0",
  "description": "Search the web with the official DeepSeek Search API",
  "type": "module",
  "main": "dist/index.js",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/c121914yu/fastgpt-plugin-deepseek-search.git"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "build": "fastgpt-plugin build --minify",
    "build:dev": "fastgpt-plugin build",
    "check": "fastgpt-plugin check --entry . --output ./dist",
    "pack": "fastgpt-plugin pack --name deepSeekSearch",
    "debug": "fastgpt-plugin debug .",
    "test": "vitest run",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@fastgpt-plugin/sdk-factory": "1.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@fastgpt-plugin/cli": "0.2.0",
    "@types/node": "22.19.19",
    "typescript": "5.9.3",
    "vitest": "4.1.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"]
  }
}
